# LegadoHub Pro 环境变量配置

# ==================== 安全 ====================
# 生产环境必须修改！用于 JWT Token 签名
SECRET_KEY=your-super-secret-key-change-this-in-production

# ==================== 数据库 ====================
DB_PATH=/data/legado_hub.db
NOVEL_DB_PATH=/data/novel.db

# ==================== Redis ====================
REDIS_URL=redis://redis:6379/0

# ==================== MinIO (对象存储) ====================
MINIO_ROOT_USER=legadohub
MINIO_ROOT_PASSWORD=legadohub-minio-password

# ==================== LLM (可选，用于 AI 增强功能) ====================
# 支持 OpenAI 兼容 API
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-openai-api-key
LLM_MODEL=gpt-4o

# ==================== 开发调试 ====================
DEBUG=false
APP_ENV=prod
LOG_LEVEL=INFO
LOG_JSON=true

# ==================== Docker 端口 ====================
WEB_PORT=8080

# ==================== Docker 构建 ====================
# 网络受限时可切换到可访问的 PyPI 镜像。
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=

# ==================== 公网（可选） ====================
# Cloudflare Dashboard 创建 Tunnel 后填写，不要提交真实 token。
CLOUDFLARE_TUNNEL_TOKEN=
